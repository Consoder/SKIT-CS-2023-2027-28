PROJECT_NAME="URL Threat Detection API"
ENVIRONMENT=development
# Security bug found 2026-09-14: DEBUG=true leaks raw Python tracebacks to
# clients on any unhandled exception, bypassing structured error handling.
# Set true only for local debugging, never in a shared/deployed environment.
DEBUG=false
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
BACKEND_CORS_ORIGINS=http://localhost:5173

# Sprint 6, Task 1 - optional. Without these, threat-intel checks degrade
# to "unavailable" per provider instead of failing the request.
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=

# Sprint 6, Task 2 - optional. Without this, caching is disabled and every
# request runs the full pipeline (still works correctly, just not cached).
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=3600

# Sprint 6, Task 3 - Postgres schema (Users, URL_Analysis, Threat_Intelligence, Audit_Logs)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/url_threat_detection

# Sprint 6, Task 4 - optional. Without these, analyses work as normal, just
# without an on-chain audit record. See "Blockchain setup" in README.md.
BLOCKCHAIN_RPC_URL=http://localhost:8545
BLOCKCHAIN_CONTRACT_ADDRESS=
BLOCKCHAIN_ACCOUNT_ADDRESS=

# Real gap found 2026-09-14 - optional. Without this, /analyze is open (no
# auth), which is fine for local dev but must be set in any real deployment.
# Clients then send it back as the X-API-Key header.
API_KEY=
