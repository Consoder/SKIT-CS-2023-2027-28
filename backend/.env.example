PROJECT_NAME="URL Threat Detection API"
ENVIRONMENT=development
# Security bug found 2026-09-14: DEBUG=true leaks raw Python tracebacks to
# clients on any unhandled exception, bypassing structured error handling.
# Set true only for local debugging, never in a shared/deployed environment.
DEBUG=false
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
BACKEND_CORS_ORIGINS=http://localhost:5173
